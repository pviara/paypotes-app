{
    "name": "paypot-app",
    "version": "1.0.1",
    "type": "module",
    "scripts": {
        "format": "prettier --write \"{src,test}/**/*.{js,json,ts,scss}\"",
        "ng": "ng",
        "start": "ng serve --no-hmr",
        "build": "ng build",
        "build:dev": "ng build --configuration development",
        "open:ios": "yarn build; npx cap sync ios; npx cap open ios",
        "open:ios:dev": "yarn build:dev; npx cap sync ios; npx cap open ios",
        "watch": "ng build --watch --configuration development",
        "test": "vitest run --config ./test/vitest.config.ts",
        "test:watch": "vitest --config ./test/vitest.config.ts",
        "serve:ssr:paypot": "node dist/paypot-app/server/server.mjs",
        "update:deps": "yarn add -D npm-check-updates yarn-audit-fix; npx npm-check-updates --upgrade --reject express; yarn install; npx yarn-audit-fix; yarn remove npm-check-updates yarn-audit-fix; echo \\\\n🚨\\[\\033[32m\\] Do not forget to upgrade manually express package."
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^20.2.4",
        "@angular/common": "^20.2.4",
        "@angular/compiler": "^20.2.4",
        "@angular/core": "^20.2.4",
        "@angular/forms": "^20.2.4",
        "@angular/platform-browser": "^20.2.4",
        "@angular/platform-browser-dynamic": "^20.2.4",
        "@angular/platform-server": "^20.2.4",
        "@angular/router": "^20.2.4",
        "@angular/service-worker": "^20.2.4",
        "@angular/ssr": "^20.2.2",
        "@capacitor/android": "^7.4.3",
        "@capacitor/assets": "^3.0.5",
        "@capacitor/browser": "^7.0.2",
        "@capacitor/cli": "^7.4.3",
        "@capacitor/core": "^7.4.3",
        "@capacitor/device": "^7.0.2",
        "@capacitor/ios": "^7.4.3",
        "@capacitor/keyboard": "^7.0.2",
        "@capacitor/screen-orientation": "^7.0.2",
        "@capgo/capacitor-social-login": "^7.11.2",
        "canvas-confetti": "^1.9.3",
        "cliui": "^9.0.1",
        "express": "^4.21.2",
        "rxjs": "~7.8.2",
        "tslib": "^2.8.1",
        "uuid": "^11.1.0",
        "whatamesh": "^0.2.0",
        "zone.js": "0.15.1"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^20.2.2",
        "@angular/cli": "^20.2.2",
        "@angular/compiler-cli": "^20.2.4",
        "@types/canvas-confetti": "^1.9.0",
        "@types/express": "^5.0.3",
        "@types/jasmine": "~5.1.9",
        "@types/node": "^24.3.1",
        "jasmine-core": "~5.10.0",
        "karma": "~6.4.4",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.1",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "prettier": "^3.6.2",
        "typescript": "~5.9.2",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "3.2.4"
    }
}
