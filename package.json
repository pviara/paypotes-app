{
    "name": "paypot-app",
    "version": "0.24.5",
    "type": "module",
    "scripts": {
        "format": "prettier --write \"{src,test}/**/*.{js,json,ts,scss}\"",
        "ng": "ng",
        "start": "ng serve --no-hmr",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "vitest run --config ./test/vitest.config.ts",
        "test:watch": "vitest --config ./test/vitest.config.ts",
        "serve:ssr:paypot": "node dist/paypot-app/server/server.mjs"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^20.1.0",
        "@angular/common": "^20.1.0",
        "@angular/compiler": "^20.1.0",
        "@angular/core": "^20.1.0",
        "@angular/forms": "^20.1.0",
        "@angular/platform-browser": "^20.1.0",
        "@angular/platform-browser-dynamic": "^20.1.0",
        "@angular/platform-server": "^20.1.0",
        "@angular/router": "^20.1.0",
        "@angular/service-worker": "^20.1.0",
        "@angular/ssr": "^20.1.0",
        "canvas-confetti": "^1.9.3",
        "cliui": "^9.0.1",
        "express": "^4.21.2",
        "npm-check-updates": "^18.0.1",
        "rxjs": "~7.8.2",
        "tslib": "^2.8.1",
        "uuid": "^11.1.0",
        "whatamesh": "^0.2.0",
        "zone.js": "0.15.1"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^20.1.0",
        "@angular/cli": "^20.1.0",
        "@angular/compiler-cli": "^20.1.0",
        "@types/canvas-confetti": "^1.9.0",
        "@types/express": "^5.0.3",
        "@types/jasmine": "~5.1.8",
        "@types/node": "^24.0.13",
        "jasmine-core": "~5.8.0",
        "karma": "~6.4.4",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.1",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "prettier": "^3.6.2",
        "typescript": "~5.8.3",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "3.2.4",
        "yarn-audit-fix": "^10.1.1"
    }
}
