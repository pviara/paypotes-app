{
    "name": "paypot-app",
    "version": "0.12.5",
    "scripts": {
        "format": "prettier --write \"{src,test}/**/*.{js,json,ts,scss}\"",
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "vitest run --config ./test/vitest.config.ts",
        "test:watch": "vitest --config ./test/vitest.config.ts",
        "serve:ssr:paypot": "node dist/paypot-app/server/server.mjs"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^18.2.3",
        "@angular/common": "^18.2.3",
        "@angular/compiler": "^18.2.3",
        "@angular/core": "^18.2.3",
        "@angular/forms": "^18.2.3",
        "@angular/platform-browser": "^18.2.3",
        "@angular/platform-browser-dynamic": "^18.2.3",
        "@angular/platform-server": "^18.2.3",
        "@angular/router": "^18.2.3",
        "@angular/service-worker": "^18.2.3",
        "@angular/ssr": "^18.2.3",
        "cliui": "^8.0.1",
        "express": "^4.19.2",
        "rxjs": "~7.8.1",
        "tslib": "^2.7.0",
        "whatamesh": "^0.2.0",
        "wrap-ansi": "^9.0.0",
        "zone.js": "0.14.10"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^18.2.3",
        "@angular/cli": "^18.2.3",
        "@angular/compiler-cli": "^18.2.3",
        "@types/express": "^4.17.21",
        "@types/jasmine": "~5.1.4",
        "@types/node": "^22.5.4",
        "jasmine-core": "~5.2.0",
        "karma": "~6.4.4",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.1",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "prettier": "^3.3.3",
        "typescript": "~5.5.4",
        "vitest": "^2.0.5"
    }
}
