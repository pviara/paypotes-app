{
    "name": "paypotes-app",
    "version": "2.0.0",
    "type": "module",
    "scripts": {
        "format": "prettier --write \"{src,test}/**/*.{js,json,ts,scss}\"",
        "ng": "ng",
        "start": "ng serve --no-hmr",
        "build": "ng build",
        "build:dev": "ng build --configuration development",
        "open:ios": "yarn build; npx cap sync ios; npx cap open ios",
        "open:ios:dev": "yarn build:dev; npx cap sync ios; npx cap open ios",
        "watch": "ng build --watch --configuration development",
        "test": "vitest run --config ./test/vitest.config.ts",
        "test:watch": "vitest --config ./test/vitest.config.ts",
        "serve:ssr:paypotes": "node dist/paypotes-app/server/server.mjs",
        "update:deps": "yarn add -D npm-check-updates yarn-audit-fix; npx npm-check-updates --upgrade; yarn install; npx yarn-audit-fix; yarn remove npm-check-updates yarn-audit-fix; echo \\\\n🚨\\[\\033[32m\\] Do not forget to upgrade manually express package."
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^21.2.6",
        "@angular/common": "^21.2.6",
        "@angular/compiler": "^21.2.6",
        "@angular/core": "^21.2.6",
        "@angular/forms": "^21.2.6",
        "@angular/platform-browser": "^21.2.6",
        "@angular/platform-browser-dynamic": "^21.2.6",
        "@angular/platform-server": "^21.2.6",
        "@angular/router": "^21.2.6",
        "@angular/service-worker": "^21.2.6",
        "@angular/ssr": "^21.2.5",
        "@capacitor/android": "^8.3.0",
        "@capacitor/assets": "^3.0.5",
        "@capacitor/browser": "^8.0.3",
        "@capacitor/cli": "^8.3.0",
        "@capacitor/core": "^8.3.0",
        "@capacitor/device": "^8.0.2",
        "@capacitor/ios": "^8.3.0",
        "@capacitor/keyboard": "^8.0.2",
        "@capacitor/screen-orientation": "^8.0.1",
        "@capgo/capacitor-social-login": "^8.3.9",
        "canvas-confetti": "^1.9.4",
        "cliui": "^9.0.1",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "rxjs": "~7.8.2",
        "tslib": "^2.8.1",
        "uuid": "^13.0.0",
        "whatamesh": "^0.2.0",
        "zone.js": "0.16.1"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^21.2.5",
        "@angular/cli": "^21.2.5",
        "@angular/compiler-cli": "^21.2.6",
        "@types/canvas-confetti": "^1.9.0",
        "@types/express": "^5.0.6",
        "@types/jasmine": "~6.0.0",
        "@types/node": "^25.5.0",
        "jasmine-core": "~6.1.0",
        "karma": "~6.4.4",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.1",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.2.0",
        "prettier": "^3.8.1",
        "typescript": "~6.0.2",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "4.1.2"
    }
}
